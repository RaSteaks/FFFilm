    "settings.appleLink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple: How storage capacity is measured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple：存储容量的计算方式"
          }
        }
      }
    },
    "settings.binaryExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binary\n1 GiB = 1024 MiB = 1,073,741,824 bytes. FFFilm uses GiB and TiB to keep the distinction explicit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1024 进制（二进制）\n1 GiB = 1024 MiB = 1,073,741,824 字节。FFFilm 使用 GiB、TiB 避免混淆。"
          }
        }
      }
    },
    "settings.binaryUnit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binary · 1 GiB = 1024 MiB"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二进制 · 1 GiB = 1024 MiB"
          }
        }
      }
    },
    "settings.capacity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacity units"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容量单位"
          }
        }
      }
    },
    "settings.decimalExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decimal\n1 GB = 1000 MB = 1,000,000,000 bytes. Common for storage manufacturers and Apple capacity labels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 进制（十进制）\n1 GB = 1000 MB = 1,000,000,000 字节。硬盘、存储卡厂商与 Apple 容量标签通常采用这种方式。"
          }
        }
      }
    },
    "settings.decimalUnit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decimal · 1 GB = 1000 MB"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "十进制 · 1 GB = 1000 MB"
          }
        }
      }
    },
