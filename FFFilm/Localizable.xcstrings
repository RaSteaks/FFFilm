    "shutter.noCandidates": {
      "comment": "No candidate status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No complete light-cycle exposure fits the current angle limit. This does not prove that flicker will occur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前帧率和最大角度下，没有覆盖全部设备完整刷新周期的共同快门；这不代表一定出现频闪。"
          }
        }
      }
    },
    "shutter.noDisplayCandidates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No common shutter covers complete refresh cycles for every display at this frame rate and angle limit. Try a lower frame rate, a higher angle limit or matching refresh rates; this does not prove flicker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前帧率和最大角度下，没有覆盖全部设备完整刷新周期的共同快门。可降低拍摄帧率、提高角度上限或统一设备刷新率；这不代表一定出现频闪。"
          }
        }
      }
    },
    "shutter.numericalLimit": {
      "comment": "Numerical limit status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values exceed calculation precision. Use a less extreme input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值超出计算精度，请使用较小范围的输入。"
          }
        }
      }
    },
    "shutter.overLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theoretical angle exceeds the %@° limit. This exposure cannot be realized within the limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "理论角度超过 %@° 上限，无法在该上限内实现此曝光。"
          }
        }
      }
    },
    "shutter.periodicModel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodic light model · verify with test footage. LED, PWM and rolling shutter may differ."
          }
