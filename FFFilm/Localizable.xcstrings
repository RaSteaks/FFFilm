    "settings.binaryExplanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binary\n1 GiB = 1024 MiB = 1,073,741,824 bytes. FFFilm uses GiB and TiB to keep the distinction explicit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1024 进制（二进制）\n1 GiB = 1024 MiB = 1,073,741,824 字节。FFFilm 使用 GiB、TiB 避免混淆。"
          }
        }
      }
    },
    "settings.binaryUnit" : {
      "localizations" : {
