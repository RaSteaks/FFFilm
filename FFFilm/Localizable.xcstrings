    "settings.unitDifferenceNote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These conventions are not exclusive to one operating system. MB is megabytes, Mb is megabits, and 1 byte = 8 bits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这两种方式并非某个系统专属。MB 表示兆字节，Mb 表示兆比特；1 字节 = 8 比特。"
          }
        }
      }
    },
    "settings.unitDifferenceTitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
