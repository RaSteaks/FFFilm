      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per-hour data, plan totals and comparisons use the selected display unit. Bitrate, recording time and utilization remain unchanged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每小时数据量、计划总量和对比方案使用所选单位。码率、可录时长和容量占用百分比不变。"
          }
        }
      }
